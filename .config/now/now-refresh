#!/usr/bin/env bash
# Regenerates ~/now/<name>.org from generators/<name>. Each generator prints the
# org body on stdout and names its title and source in "# now-title:" and
# "# now-source:" lines. Add a file by dropping an executable into generators/
# and a timer for now@<name>.
set -uo pipefail

here=$(dirname "$(readlink -f "$0")")
out_dir=${NOW_DIR:-$HOME/now}
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/now
mkdir -p "$out_dir" "$state_dir"

if [ $# -eq 0 ]; then
  set -- $(cd "$here/generators" && ls)
fi

status=0
for name in "$@"; do
  gen=$here/generators/$name
  out=$out_dir/$name.org
  good=$state_dir/$name.good
  good_at=$state_dir/$name.good-at
  title=$(sed -n 's/^# now-title: //p' "$gen" | head -1)
  source=$(sed -n 's/^# now-source: //p' "$gen" | head -1)
  now=$(date '+%Y-%m-%d %H:%M %Z')
  body=$state_dir/$name.body
  err=$state_dir/$name.err
  tmp=$(mktemp "$out_dir/.$name.XXXXXX")

  timeout 5m "$gen" >"$body" 2>"$err"
  rc=$?
  if [ "$rc" -eq 0 ] && [ ! -s "$body" ]; then
    rc="0, empty output"
  fi

  {
    printf '#+TITLE: %s\n' "${title:-$name}"
    printf '# Generated by ~/.config/now/now-refresh %s. Read-only: edits are overwritten.\n' "$name"
    if [ "$rc" = 0 ]; then
      printf 'Source: %s · Generated: %s\n\n' "$source" "$now"
      cat "$body"
    else
      printf 'ERROR: %s failed at %s (exit %s). Everything below is STALE.\n' "$source" "$now" "$rc"
      tail -n 5 "$err" | sed 's/^/    /'
      if [ -s "$good" ]; then
        printf '\nLast good: %s\n\n' "$(cat "$good_at")"
        cat "$good"
      else
        printf '\nNo successful run yet.\n'
      fi
    fi
  } >"$tmp"

  if [ "$rc" = 0 ]; then
    mv -f "$body" "$good"
    printf '%s\n' "$now" >"$good_at"
  else
    echo "now-refresh: $name failed (exit $rc)" >&2
    cat "$err" >&2
    status=1
  fi
  chmod 644 "$tmp"
  mv -f "$tmp" "$out"
done
exit $status
