{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "'/home/tj/.local/bin/moshi-hook' codex-hook",
            "type": "command"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "bd codex-hook PostCompact",
            "statusMessage": "Loading Beads context",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "atuin hook codex",
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      },
      {
        "hooks": [
          {
            "command": "python3 '/home/tj/.claude/hooks/herdr-bead-name.py'",
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "atuin hook codex",
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "atuin hook codex",
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/usr/bin/node \"/home/tj/.codex/hooks/codegraph-worktree-bootstrap.js\"",
            "statusMessage": "Preparing the CodeGraph index",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      },
      {
        "hooks": [
          {
            "command": "bash '/home/tj/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bd codex-hook SessionStart",
            "statusMessage": "Loading Beads context",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      },
      {
        "hooks": [
          {
            "command": "'/home/tj/.local/bin/moshi-hook' codex-hook",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "'/home/tj/.local/bin/moshi-hook' codex-hook",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "'/home/tj/.local/bin/moshi-hook' codex-hook",
            "type": "command"
          }
        ]
      }
    ]
  }
}
